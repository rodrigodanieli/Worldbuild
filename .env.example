# =========================================================================
# 🏰 WorldBuild Hub - Variáveis de Ambiente para Self-Hosting
# =========================================================================

# Porta em que o serviço responderá no host (Padrão: 3000)
PORT=3000

# -------------------------------------------------------------------------
# OPÇÃO A: SQLite (Recomendado para uso pessoal, leve, zero infra extra)
# -------------------------------------------------------------------------
DATABASE_URL="file:/app/packages/database/data/dev.db"

# -------------------------------------------------------------------------
# OPÇÃO B: PostgreSQL (Recomendado para servidores multi-usuário e alta escala)
# Descomente as linhas abaixo e execute: docker compose --profile postgres up -d
# -------------------------------------------------------------------------
# DATABASE_URL="postgresql://worldbuild:worldbuild_pass_123@postgres:5432/worldbuild?schema=public"
# POSTGRES_USER=worldbuild
# POSTGRES_PASSWORD=worldbuild_pass_123
# POSTGRES_DB=worldbuild
# POSTGRES_PORT=5432
# COMPOSE_PROFILES=postgres

# -------------------------------------------------------------------------
# Segurança e Sessão
# -------------------------------------------------------------------------
SESSION_SECRET="sua-chave-secreta-aleatoria-minimo-32-caracteres"
NODE_ENV=production
